<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Speckle.AutoCAD.API" Version="2023.0.0" ExcludeAssets="runtime" />
		<PackageReference Include="Speckle.Civil3D.API" Version="2023.0.0" ExcludeAssets="runtime" />

	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Extentions\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Core.Application">
			<Alias>Application</Alias>
		</Using>
		<Using Include="Autodesk.AutoCAD.DatabaseServices.ObjectId">
			<Alias>ObjectId</Alias>
		</Using>
		<Using Include="Shared.Extensions" />
	</ItemGroup>

</Project>
