<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CSharpFunctionalExtensions" Version="3.6.0" />
		<PackageReference Include="Speckle.AutoCAD.API" Version="2023.0.0" ExcludeAssets="runtime" />
		<PackageReference Include="Speckle.Civil3D.API" Version="2023.0.0" ExcludeAssets="runtime" />
		<PackageReference Include="System.Resources.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Resources\dust.png" />
		<None Include="Resources\plumbing.png" />
		<None Include="Resources\pencil-drawing-circles.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Extentions\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Core.Application">
			<Alias>Application</Alias>
		</Using>
		<Using Include="Autodesk.AutoCAD.DatabaseServices.ObjectId">
			<Alias>ObjectId</Alias>
		</Using>
		<Using Include="Shared.Extensions" />
	</ItemGroup>
</Project>