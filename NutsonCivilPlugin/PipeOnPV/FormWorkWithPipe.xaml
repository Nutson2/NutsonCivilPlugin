<Window x:Class="NutsonCivilPlugin.PipeOnPV.FormWorkWithPipe"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:NutsonCivilPlugin.PipeOnPV"
            mc:Ignorable="d" 
            x:Name="mainWindow"
            Background="AliceBlue" 
            MinWidth="400" MinHeight="300" 
            MaxHeight="1000"
            WindowStartupLocation="CenterScreen" 
             >
    <Grid Height="{Binding ElementName=mainWindow, Path=Height}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" >
            <Button x:Name="BtSelectPV"  Margin="5" Click="BtSelectPV_Click" >
                <TextBlock Text="Выбрать вид профиля" TextWrapping="Wrap" TextAlignment="Center" Padding="2,0,2,0"/>
            </Button>
            <TextBlock x:Name="TbPVName"  Margin="5" TextWrapping="Wrap" MinWidth="250" 
                        Background="LightYellow" Text="{Binding Path=ProfileView.Name}" 
                        TextAlignment="Center"  />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Трубопроводы">
                <ListBox  x:Name="Pipes" MinHeight="200"  Margin="5" 
                            SelectionMode="Extended" >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Тип: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Path=Part.Domain}" Width="30" />
                                <TextBlock Text="  Имя: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Path=Part.Name}"  Width="100"/>

                                <ComboBox x:Name="pipeFamilyType" 
                                            ItemsSource="{Binding Path=ListPartFamilyTypes,Mode=OneTime}" 
                                            SelectedItem="{Binding PartFamily}"
                                            SelectionChanged="FamilyType_SelectionChanged"/>

                                <ComboBox x:Name="pipePartSize"  
                                            ItemsSource="{Binding Path=ListPartSizes}"
                                            SelectedItem="{Binding Path=PartSize }"
                                            SelectionChanged="PartSize_SelectionChanged"   />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </TabItem>

            <TabItem Header="Колодцы">
                <ListBox  x:Name="Structures" MinHeight="200"  Margin="5" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Тип: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Path=Part.Domain}" Width="30" />
                                <TextBlock Text="  Имя: " Foreground="Gray"/>
                                <TextBlock Text="{Binding Path=Part.Name}"  Width="100"/>

                                <ComboBox x:Name="structureFamilyType"
                                            ItemsSource="{Binding Path=ListPartFamilyTypes}" 
                                            SelectedItem="{Binding Path=PartFamily}"
                                            SelectionChanged="FamilyType_SelectionChanged"/>

                                <ComboBox ItemsSource="{Binding Path=ListPartSizes, Mode=OneWay}"
                                            SelectedItem="{Binding Path=PartSize}"
                                            SelectionChanged="PartSize_SelectionChanged"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </TabItem>
        </TabControl>
    </Grid>
</Window>
