<Window x:Class="NutsonCivilPlugin.PipeOnPV.Views.FormWorkWithPipe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:NutsonCivilPlugin.PipeOnPV.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:ViewModelPipeOnPV}"
        mc:Ignorable="d"
        x:Name="mainWindow"
        Background="AliceBlue"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
   <Grid >
      <Grid.RowDefinitions>
         <RowDefinition Height="35" />
         <RowDefinition Height="*" />
         <RowDefinition Height="auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0"
                  Orientation="Horizontal"
                  FlowDirection="RightToLeft">
         <Button x:Name="BtSelectPV"
                 Margin="5"
                 Command="{Binding SelectProfileViewCommand}">
            <TextBlock Text="Выбрать вид профиля"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Padding="2,0,2,0" />
         </Button>
         <TextBlock Margin="5"
                    TextWrapping="Wrap"
                    MinWidth="250"
                    Background="LightYellow"
                    Text="{Binding Path=ProfileView.Name}"
                    TextAlignment="Center" />
      </StackPanel>

      <TabControl Grid.Row="1"
                  TabIndex="{Binding TabIndex}">
         <TabItem Header="Трубопроводы">
            <DataGrid MinHeight="200"
                      AutoGenerateColumns="false"
                      CanUserAddRows="False"
                      SelectionUnit="Cell"
                      SelectionMode="Extended"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      DataGridCell.Selected="DataGridCell_Selected"
                      ItemsSource="{Binding Pipes}">
               <DataGrid.Columns>
                  <DataGridTextColumn Header="Имя"
                                      Binding="{Binding Name}"
                                      Width="100" />
                  <!-- Колонка с ComboBox для выбора семейства -->
                  <DataGridTemplateColumn Header="Семейство">
                     <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding SelectedPartFamily.Name}" />
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                     <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                           <ComboBox ItemsSource="{Binding PartFamilies}"
                                     SelectedItem="{Binding SelectedPartFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="Name" />
                        </DataTemplate>
                     </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>

                  <!-- Колонка с ComboBox для выбора размера (зависит от выбранного семейства) -->
                  <DataGridTemplateColumn Header="Размер">
                     <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding SelectedPartSize.Name}" />
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                     <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                           <ComboBox ItemsSource="{Binding SelectedPartFamilyPartSizes}"
                                     SelectedItem="{Binding SelectedPartSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DisplayMemberPath="Name" />
                        </DataTemplate>
                     </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
               </DataGrid.Columns>
            </DataGrid>
         </TabItem>

         <TabItem Header="Колодцы">
            <ListBox  x:Name="Structures"
                      MinHeight="200"
                      Margin="5"
                      SelectionMode="Extended"
                      ItemsSource="{Binding modelStructures}">
               <ListBox.ItemTemplate>
                  <DataTemplate>
                     <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Тип: "
                                   Foreground="Gray" />
                        <TextBlock Text="{Binding Path=Part.Domain}"
                                   Width="30" />
                        <TextBlock Text="  Имя: "
                                   Foreground="Gray" />
                        <TextBlock Text="{Binding Path=Part.Name}"
                                   Width="100" />

                        <ComboBox x:Name="structureFamilyType"
                                  ItemsSource="{Binding Path=ListPartFamilyTypes}"
                                  SelectedItem="{Binding Path=PartFamily}" />

                        <ComboBox ItemsSource="{Binding Path=ListPartSizes, Mode=OneWay}"
                                  SelectedItem="{Binding Path=PartSize}" />
                     </StackPanel>
                  </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>

         </TabItem>
      </TabControl>
      <Button Grid.Row="2"
              Content="Применить"
              Margin="10,3"
              HorizontalAlignment="Right"
              Command="{Binding ModifyElementsCommand}" />
   </Grid>
</Window>
