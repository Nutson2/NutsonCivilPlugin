<Window x:Class="NutsonCivilPlugin.PropertySet.PropertySetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:NutsonCivilPlugin.PropertySet"
        xmlns:vm="clr-namespace:NutsonCivilPlugin.PropertySet"
        d:DataContext="{d:DesignInstance Type=vm:PropertySetsManagerViewModel}"
        mc:Ignorable="d"
        Background="AliceBlue"
        MinWidth="400"
        MinHeight="600"
        Height="600"
        Width="400"
        WindowStartupLocation="CenterScreen">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="50" />
         <RowDefinition />
         <RowDefinition Height="50" />
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
         <TextBlock TextWrapping="Wrap"
                    Text="Количество характеристик в чертеже: " />
         <TextBlock Text="{Binding Path=PropCount}" />
      </StackPanel>

      <ListBox x:Name="listParamSetName"
               ItemsSource="{Binding AllDrawingPropsName}"
               Margin="7"
               Grid.Row="1"
               SelectionMode="Extended" />

      <Button Grid.Row="2"
              Margin="7"
              Click="Button_Click">
         <TextBlock TextWrapping="Wrap"
                    TextAlignment="Center"
                    Text="Удалить выбранные характеристики из чертежа" />

      </Button>
   </Grid>
</Window>
